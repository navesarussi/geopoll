{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "SET_BY_WORKFLOW_FROM_ASC_APP_ID",
        "ascApiKeyPath": "./asc_api_key.p8",
        "ascApiKeyIssuerId": "SET_BY_WORKFLOW",
        "ascApiKeyId": "SET_BY_WORKFLOW"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
