# Google OAuth (Nave must provide): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=             # e.g. https://<deployment>.vercel.app
DEMO_LOGIN=1              # DEMO ONLY: unauthenticated demo login
ISSUER_PRIVATE_JWK=       # npm run gen-issuer-key (RSA-PSS SHA-384 2048, JSON JWK)
IDENTITY_HMAC_KEY=        # openssl rand -hex 32
SEED_DUMMY_VOTES=240      # dummy ballots for demo
SNAPSHOT_INTERVAL_SECONDS=60   # demo; production default 86400 (daily, ADR-0020)
DATABASE_URL=             # optional Postgres; empty = in-memory
