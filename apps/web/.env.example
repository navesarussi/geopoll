# Google OAuth (Nave must provide): https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=          # openssl rand -base64 32
NEXTAUTH_URL=             # e.g. https://<deployment>.vercel.app
DEMO_LOGIN=1              # DEMO ONLY: unauthenticated demo login
ISSUER_PRIVATE_JWK=       # npm run gen-issuer-key (RSA-PSS SHA-384 2048, JSON JWK)
IDENTITY_HMAC_KEY=        # openssl rand -hex 32
SEED_DUMMY_VOTES=240      # dummy ballots for demo
SNAPSHOT_INTERVAL_SECONDS=60   # demo; production default 86400 (daily, ADR-0020)
DATABASE_URL=             # optional Postgres; empty = in-memory
BATCH_INTERVAL_SECONDS=60      # demo; default 3600 (hourly ingestion batches, ADR-0020)
CONTENT_HMAC_KEY=              # openssl rand -hex 32 (zone C author key; must differ from IDENTITY_HMAC_KEY)
ISSUER_PRIVATE_JWK_T1=         # one issuer key per tier (T0 falls back to ISSUER_PRIVATE_JWK)
FEATURE_T1_ID=0                # needs-lawyer: Google+ID tier placeholder (#40)
NEXT_PUBLIC_RELAY_URL=         # external relay base (default /api/relay, same deployment, beta)
RELAY_UPSTREAM=                # where the relay forwards (default: own origin)
RELAY_SECRET=                  # openssl rand -hex 32; with RELAY_ONLY=1 the vote API requires it
RELAY_ONLY=0
NEXT_PUBLIC_BETA_INCLUSION_CHECK=1
ANON_HMAC_KEY=                 # openssl rand -hex 32 (ADR-0023 anonymous posts; must differ from CONTENT_HMAC_KEY)
MOD_SEAL_PUBLIC_KEY=           # optional PEM; private key OFFLINE (sealed moderation, ADR-0023, lawyer B9)
