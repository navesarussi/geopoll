#!/usr/bin/env python3
"""Create GitHub labels/milestones/issues from docs/roadmap/backlog.md.

DRY-RUN by default: prints what would be created. Use --apply to actually
create (requires `gh` auth and Nave's approval). Idempotent-ish: skips issues
whose title already exists.
"""
import argparse, json, re, subprocess, sys, pathlib

ROOT = pathlib.Path(__file__).resolve().parent.parent
BACKLOG = ROOT / "docs/roadmap/backlog.md"
LABELS = ROOT / ".github/labels.yml"

def parse():
    tasks, epic, cur = [], None, None
    for line in BACKLOG.read_text(encoding="utf-8").splitlines():
        if m := re.match(r"^## (E\d+) · (.+)", line):
            epic = f"{m[1]} · {m[2]}"
        elif m := re.match(r"^### (T-\d+): (.+)", line):
            cur = {"id": m[1], "title": m[2], "epic": epic}
            tasks.append(cur)
        elif cur and (m := re.match(r"^- \*\*([\w-]+):\*\* (.+)", line)):
            cur[m[1]] = m[2].strip()
    return tasks

def parse_labels():
    out = []
    for line in LABELS.read_text(encoding="utf-8").splitlines():
        m = re.match(r'^- \{name: "([^"]+)", color: "([0-9a-f]+)", description: "(.*)"\}', line)
        if m: out.append({"name": m[1], "color": m[2], "description": m[3].replace('\\"', '"')})
    return out

def body(t):
    return (f"**Epic:** {t['epic']}\n**Phase:** {t.get('phase')}\n"
            f"**Agent-suitable:** {t.get('agent')}\n**Needs lawyer:** {t.get('needs-lawyer')}\n"
            f"**Depends on:** {t.get('depends')}\n\n### Acceptance criteria\n{t.get('acceptance')}\n\n"
            f"Source: docs/roadmap/backlog.md ({t['id']}). Follow AGENTS.md.")

def run(cmd, apply):
    print(("RUN  " if apply else "DRY  ") + " ".join(cmd))
    if apply:
        subprocess.run(cmd, check=True)

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--apply", action="store_true", help="actually create (default: dry-run)")
    ap.add_argument("--repo", default=None)
    a = ap.parse_args()
    repo = ["--repo", a.repo] if a.repo else []
    tasks = parse()
    required = {"phase", "labels", "agent", "needs-lawyer", "depends", "acceptance"}
    bad = [t["id"] for t in tasks if not required <= t.keys()]
    if bad:
        sys.exit(f"missing fields in: {bad}")
    known = {l["name"] for l in parse_labels()}
    for t in tasks:
        unknown = {x.strip() for x in t["labels"].split(",")} - known
        if unknown:
            sys.exit(f"{t['id']}: unknown labels {unknown}")
    for l in parse_labels():
        run(["gh", "label", "create", l["name"], "--color", l["color"], "--description", l["description"], "--force", *repo], a.apply)
    for ph in sorted({t["phase"] for t in tasks}):
        run(["gh", "api", "-X", "POST", "repos/{owner}/{repo}/milestones", "-f", f"title=Phase {ph}"], a.apply)
    existing = set()
    if a.apply:
        out = subprocess.run(["gh", "issue", "list", "--state", "all", "--limit", "500", "--json", "title", *repo], capture_output=True, text=True, check=True).stdout
        existing = {i["title"] for i in json.loads(out)}
    for t in tasks:
        title = f"{t['id']}: {t['title']}"
        if title in existing:
            print("SKIP", title); continue
        labels = [x.strip() for x in t["labels"].split(",")] + [f"phase:{t['phase']}"]
        if t["needs-lawyer"] == "yes" and "needs-lawyer" not in labels: labels.append("needs-lawyer")
        cmd = ["gh", "issue", "create", "--title", title, "--body", body(t), "--milestone", f"Phase {t['phase']}", *repo]
        for l in dict.fromkeys(labels): cmd += ["--label", l]
        run(cmd, a.apply)
    print(f"\n{len(tasks)} tasks parsed. {'APPLIED' if a.apply else 'Dry-run only; nothing created.'}")

if __name__ == "__main__":
    main()
