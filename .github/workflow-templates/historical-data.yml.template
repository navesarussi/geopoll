# Inactive template (activating workflows requires Nave's approval per AGENTS.md).
name: historical-data
on:
  pull_request:
    paths: ["services/historical-data/**"]
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: services/historical-data
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: python -m unittest discover -s tests -t . -v
